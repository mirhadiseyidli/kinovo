<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= event.title %> - Kinovo</title>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            background-color: #151718;
            color: #ECEDEE;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .container {
            max-width: 100%;
            margin: 0 auto;
            background-color: #151718;
            min-height: 100vh;
        }

        /* Event Image Section */
        .event-image-section {
            width: 100%;
            padding-top: 32px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .event-image-container {
            width: 60%;
            aspect-ratio: 1;
            border-radius: 16px;
            overflow: hidden;
            position: relative;
        }

        .event-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 16px;
        }

        .event-image-fallback {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #15b8a7, #3ac0a8);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            font-size: 48px;
            color: white;
        }

        /* Event Details Section */
        .event-details {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* Title and Category */
        .title-and-category {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .event-title {
            font-size: 24px;
            font-weight: bold;
            color: #ECEDEE;
            line-height: 1.2;
        }

        .event-category {
            font-size: 16px;
            color: #15b8a7;
            text-transform: capitalize;
            font-weight: 500;
        }

        /* Time and Date */
        .time-and-date {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .time-icon {
            width: 24px;
            height: 24px;
            background-color: #15b8a7;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .time-details {
            flex: 1;
        }

        .time-text {
            font-size: 16px;
            color: #ECEDEE;
            line-height: 1.4;
        }

        /* Location */
        .location-info {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .location-icon {
            width: 24px;
            height: 24px;
            background-color: #15b8a7;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .location-text {
            font-size: 16px;
            color: #ECEDEE;
            line-height: 1.4;
            flex: 1;
        }

        /* Description */
        .description {
            color: #cecece;
            font-size: 16px;
            line-height: 1.6;
        }

        /* Visibility */
        .visibility-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .visibility-icon {
            width: 24px;
            height: 24px;
            background-color: #15b8a7;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .visibility-text {
            font-size: 16px;
            color: #ECEDEE;
            text-transform: capitalize;
        }

        /* Creator Info */
        .creator-info {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 8px;
        }

        .creator-avatar {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            object-fit: cover;
        }

        .creator-avatar-fallback {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 18px;
        }

        .creator-details {
            flex: 1;
        }

        .creator-label {
            font-size: 14px;
            color: #cecece;
            margin-bottom: 2px;
        }

        .creator-name {
            font-size: 16px;
            font-weight: 500;
            color: #ECEDEE;
        }

        /* App CTA */
        .app-cta {
            background-color: #15b8a7;
            color: white;
            padding: 16px 24px;
            border-radius: 12px;
            text-align: center;
            text-decoration: none;
            display: block;
            margin: 24px 16px 32px 16px;
            font-weight: 600;
            font-size: 16px;
            transition: background-color 0.2s ease;
        }

        .app-cta:hover {
            background-color: #0d9488;
        }

        /* Icon styles */
        .icon {
            width: 16px;
            height: 16px;
            fill: white;
        }

        /* Responsive */
        @media (min-width: 768px) {
            .container {
                max-width: 600px;
                margin: 0 auto;
                border-radius: 12px;
                margin-top: 20px;
                min-height: calc(100vh - 40px);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Event Image Section -->
        <div class="event-image-section">
            <div class="event-image-container">
                <% if (event.event_picture) { %>
                    <img src="<%= event.event_picture %>" alt="<%= event.title %>" class="event-image" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="event-image-fallback" style="display: none;">
                        🏃‍♂️
                    </div>
                <% } else { %>
                    <div class="event-image-fallback">
                        🏃‍♂️
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Event Details -->
        <div class="event-details">
            <!-- Title and Category -->
            <div class="title-and-category">
                <div class="event-title"><%= event.title %></div>
                <% if (event.category) { %>
                    <div class="event-category"><%= event.category %></div>
                <% } %>
            </div>

            <!-- Time and Date -->
            <div class="time-and-date">
                <div class="time-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12,6 12,12 16,14"/>
                    </svg>
                </div>
                <div class="time-details">
                    <div class="time-text">
                        <%= new Date(event.start_time).toLocaleDateString('en-US', { 
                            weekday: 'long', 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric', 
                            hour: 'numeric', 
                            minute: '2-digit' 
                        }) %>
                        <% if (event.end_time) { %>
                            <br>to <%= new Date(event.end_time).toLocaleDateString('en-US', { 
                                weekday: 'long', 
                                year: 'numeric', 
                                month: 'long', 
                                day: 'numeric', 
                                hour: 'numeric', 
                                minute: '2-digit' 
                            }) %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Location -->
            <% if (event.location && event.location.text) { %>
            <div class="location-info">
                <div class="location-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                        <circle cx="12" cy="10" r="3"/>
                    </svg>
                </div>
                <div class="location-text"><%= event.location.text %></div>
            </div>
            <% } %>

            <!-- Description -->
            <% if (event.description) { %>
            <div class="description">
                <%= event.description %>
            </div>
            <% } %>

            <!-- Visibility -->
            <div class="visibility-info">
                <div class="visibility-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <% if (event.visibility === 'public') { %>
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        <% } else { %>
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <circle cx="12" cy="16" r="1"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        <% } %>
                    </svg>
                </div>
                <div class="visibility-text"><%= event.visibility || 'public' %> event</div>
            </div>

            <!-- Creator Info -->
            <div class="creator-info">
                <% if (event.creator.profile_picture) { %>
                    <img src="<%= event.creator.profile_picture %>" alt="<%= event.creator.full_name %>" class="creator-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="creator-avatar-fallback" style="display: none;">
                        <%= event.creator.full_name.charAt(0).toUpperCase() %>
                    </div>
                <% } else { %>
                    <div class="creator-avatar-fallback">
                        <%= event.creator.full_name.charAt(0).toUpperCase() %>
                    </div>
                <% } %>
                <div class="creator-details">
                    <div class="creator-label">Created by</div>
                    <div class="creator-name"><%= event.creator.full_name %></div>
                </div>
            </div>
        </div>

        <!-- App CTA -->
        <a href="#" onclick="openApp()" class="app-cta">
            Open in Kinovo App
        </a>

        <script>
            function openApp() {
                const eventId = '<%= eventId %>';
                const appScheme = `kinovo://event/${eventId}`;
                const appStoreUrl = '<%= appStoreUrl %>';
                
                // Try to open the app with custom scheme
                const appLink = document.createElement('a');
                appLink.href = appScheme;
                appLink.click();
                
                // Fallback to App Store after a short delay
                setTimeout(() => {
                    window.location.href = appStoreUrl;
                }, 1000);
            }
        </script>
    </div>
</body>
</html> 