<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.full_name %> - Kinovo Profile</title>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            background-color: #151718;
            color: #ECEDEE;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .container {
            max-width: 100%;
            margin: 0 auto;
            background-color: #151718;
            min-height: 100vh;
        }

        /* Profile Header Section */
        .profile-header {
            padding: 32px 16px 24px 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
        }

        /* Cover Photo Area */
        .cover-photo-area {
            width: 100%;
            height: 200px;
            background: linear-gradient(135deg, #15b8a7, #3ac0a8);
            border-radius: 16px;
            margin-bottom: -60px;
            position: relative;
            overflow: hidden;
        }

        .cover-photo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 16px;
        }

        .cover-photo-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 60%;
            background: linear-gradient(to top, rgba(21, 23, 24, 0.8), transparent);
            border-radius: 0 0 16px 16px;
        }

        /* Profile Photo */
        .profile-photo-container {
            position: relative;
            z-index: 2;
            margin-bottom: 16px;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 60px;
            border: 4px solid #151718;
            object-fit: cover;
            background-color: #151718;
        }

        .profile-avatar-fallback {
            width: 120px;
            height: 120px;
            border-radius: 60px;
            border: 4px solid #151718;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 48px;
            background-color: #151718;
        }

        /* Profile Info */
        .profile-info {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            width: 100%;
        }

        .profile-name {
            font-size: 28px;
            font-weight: bold;
            color: #ECEDEE;
            text-align: center;
            line-height: 1.2;
        }

        /* Bio Section */
        .bio-section {
            padding: 0 16px 24px 16px;
            width: 100%;
        }

        .bio-content {
            background-color: #222527;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #4B5563;
        }

        .bio-label {
            font-size: 16px;
            font-weight: 600;
            color: #15b8a7;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .bio-icon {
            width: 20px;
            height: 20px;
            fill: #15b8a7;
        }

        .bio-text {
            color: #cecece;
            font-size: 16px;
            line-height: 1.6;
        }

        .bio-placeholder {
            color: #7e7e8a;
            font-style: italic;
            font-size: 16px;
            line-height: 1.6;
        }

        /* Privacy Notice */
        .privacy-notice {
            padding: 16px;
            margin: 16px;
            background-color: #222527;
            border-radius: 12px;
            border: 1px solid #4B5563;
            text-align: center;
        }

        .privacy-notice-title {
            font-size: 16px;
            font-weight: 600;
            color: #15b8a7;
            margin-bottom: 8px;
        }

        .privacy-notice-text {
            font-size: 14px;
            color: #cecece;
            line-height: 1.5;
        }

        /* App CTA */
        .app-cta {
            background-color: #15b8a7;
            color: white;
            padding: 16px 24px;
            border-radius: 12px;
            text-align: center;
            text-decoration: none;
            display: block;
            margin: 24px 16px 32px 16px;
            font-weight: 600;
            font-size: 16px;
            transition: background-color 0.2s ease;
        }

        .app-cta:hover {
            background-color: #0d9488;
        }

        /* Icon styles */
        .icon {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }

        /* Responsive */
        @media (min-width: 768px) {
            .container {
                max-width: 600px;
                margin: 0 auto;
                border-radius: 12px;
                margin-top: 20px;
                min-height: calc(100vh - 40px);
            }

            .profile-header {
                padding: 40px 24px 32px 24px;
            }

            .bio-section {
                padding: 0 24px 32px 24px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Profile Header -->
        <div class="profile-header">
            <!-- Cover Photo Area -->
            <div class="cover-photo-area">
                <div class="cover-photo-overlay"></div>
            </div>

            <!-- Profile Photo -->
            <div class="profile-photo-container">
                <% if (user.profile_picture) { %>
                    <img src="<%= user.profile_picture %>" alt="<%= user.full_name %>" class="profile-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="profile-avatar-fallback" style="display: none;">
                        <%= user.full_name.charAt(0).toUpperCase() %>
                    </div>
                <% } else { %>
                    <div class="profile-avatar-fallback">
                        <%= user.full_name.charAt(0).toUpperCase() %>
                    </div>
                <% } %>
            </div>

            <!-- Profile Info -->
            <div class="profile-info">
                <div class="profile-name"><%= user.full_name %></div>
            </div>
        </div>

        <!-- Bio Section -->
        <div class="bio-section">
            <div class="bio-content">
                <div class="bio-label">
                    <svg class="bio-icon" viewBox="0 0 24 24">
                        <path d="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8.01 8.01 0 0 1-8 8z"/>
                        <path d="M11 11h2v6h-2z"/>
                        <path d="M11 7h2v2h-2z"/>
                    </svg>
                    About
                </div>
                <% if (user.bio && user.bio.trim()) { %>
                    <div class="bio-text"><%= user.bio %></div>
                <% } else { %>
                    <div class="bio-placeholder">No bio available</div>
                <% } %>
            </div>
        </div>

        <!-- Privacy Notice -->
        <div class="privacy-notice">
            <div class="privacy-notice-title">🔒 Privacy Protected</div>
            <div class="privacy-notice-text">
                Full profile details, events, and friends are only visible within the Kinovo app to protect user privacy.
            </div>
        </div>

        <!-- App CTA -->
        <a href="#" onclick="openApp()" class="app-cta">
            View Full Profile in Kinovo App
        </a>

        <script>
            function openApp() {
                const userId = '<%= userId %>';
                const appScheme = `kinovo://profile/${userId}`;
                const appStoreUrl = '<%= appStoreUrl %>';
                
                // Try to open the app with custom scheme
                const appLink = document.createElement('a');
                appLink.href = appScheme;
                appLink.click();
                
                // Fallback to App Store after a short delay
                setTimeout(() => {
                    window.location.href = appStoreUrl;
                }, 1000);
            }
        </script>
    </div>
</body>
</html> 